{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avn/computer_vision/currency/manifest.schema.json",
  "title": "EGP banknote fixture manifest (WS09-02)",
  "description": "One entry per photo. The photos themselves stay on the team drive; only this manifest is committed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "classes_file",
    "images"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "classes_file": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "class",
          "sha256",
          "source",
          "licence",
          "consent",
          "lighting",
          "angle",
          "blur",
          "collected_by",
          "checked_by"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[^/\\\\][^\\\\]*\\.(jpg|jpeg|png)$"
          },
          "class": {
            "type": "string",
            "pattern": "^egp_[0-9a-z_]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "own_photo, or the dataset URL"
          },
          "licence": {
            "type": "string",
            "minLength": 1,
            "description": "project-owned, CC BY 4.0, ... Never blank; UNKNOWN is rejected"
          },
          "consent": {
            "type": "string",
            "minLength": 1,
            "description": "who allowed the photo and how (own notes: photographer), or n/a for an open dataset"
          },
          "lighting": {
            "enum": [
              "daylight",
              "indoor",
              "dim",
              "flash",
              "normal",
              "bright",
              "unknown"
            ]
          },
          "angle": {
            "enum": [
              "flat",
              "tilted",
              "steep",
              "unknown"
            ]
          },
          "blur": {
            "enum": [
              "sharp",
              "slight",
              "blurry",
              "unknown"
            ]
          },
          "collected_by": {
            "type": "string",
            "minLength": 1
          },
          "checked_by": {
            "type": "string",
            "minLength": 1,
            "description": "The second person who checked the label; \"PENDING ...\" until someone has."
          }
        }
      }
    }
  }
}
